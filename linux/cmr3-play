#!/bin/sh
# Plays Colin McRae Rally 3 on Linux through Wine and gamescope.
#
#   cmr3-play           show the settings window, then start the game
#   cmr3-play --play    start the game with the saved settings (no window)
#   cmr3-play stop      end the game
#   cmr3-play status    running or idle
#
# The settings window is CMR3Launcher.exe's own (the same as on Windows),
# shown through Wine before gamescope starts. Settings live in launcher.cfg
# inside the Wine prefix, the gamescope scaler included.
#
# Optional environment:
#   CMR3_PREFIX    Wine prefix       (default ~/.local/share/cmr3-launcher/prefix)
#   CMR3_LAUNCHER  CMR3Launcher.exe  (default: next to this script, or one folder up)
#   CMR3_RUN       a wrapper that runs wine and gamescope, e.g.
#                  "distrobox enter gaming --" when they live in a container
#   CMR3_WAIT      set: wait for the game to end (the AppImage sets it)
set -u
HERE=$(dirname "$(readlink -f "$0")")
PREFIX=${CMR3_PREFIX:-$HOME/.local/share/cmr3-launcher/prefix}
LAUNCHER=${CMR3_LAUNCHER:-}
if [ -z "$LAUNCHER" ]; then
  for p in "$HERE/CMR3Launcher.exe" "$HERE/../CMR3Launcher.exe"; do
    [ -f "$p" ] && LAUNCHER=$(readlink -f "$p") && break
  done
fi
RUN=${CMR3_RUN:-}
STATE=$HOME/.config/cmr3-launcher
mkdir -p "$STATE" "$PREFIX"

# launcher.cfg is the one the launcher itself uses: next to its exe (a
# portable install or the AppImage), or in the prefix user's
# AppData\Local\CMR3Launcher.
CFG=
if [ -n "$LAUNCHER" ]; then
  for p in "$(dirname "$LAUNCHER")/launcher.cfg" "$(dirname "$(dirname "$LAUNCHER")")/launcher.cfg"; do
    [ -f "$p" ] && CFG=$(readlink -f "$p")
  done
fi
if [ -z "$CFG" ]; then
  for d in "$PREFIX"/drive_c/users/*/AppData/Local/CMR3Launcher; do
    case "$d" in */users/Public/*|*'*'*) continue ;; esac
    [ -d "$d" ] && CFG=$d/launcher.cfg
  done
  [ -z "$CFG" ] && CFG=$PREFIX/drive_c/users/$USER/AppData/Local/CMR3Launcher/launcher.cfg
fi

get_key() { [ -f "$CFG" ] && sed -n "s|^$1 *= *||p" "$CFG" | tail -1; }
LOCK=$STATE/running.pid
# Running, or still starting: Rally_3PC.exe exists, or the gamescope
# session we started is alive (the launcher copies files before the game
# appears).
running() {
  pgrep -x Rally_3PC.exe >/dev/null && return 0
  [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null
}

# The best GPU for the game, as environment assignments (none: the
# default GPU). A player's own DRI_PRIME / __NV_PRIME_RENDER_OFFLOAD wins.
# - NVIDIA with its driver and OpenGL library: NVIDIA's render offload,
#   which picks it over an integrated GPU (harmless when it drives the
#   screen anyway). The Vulkan layer matters too: DXVK draws through it.
# - Several Mesa GPUs, the screen's one integrated (Intel, or less video
#   memory than another): DRI_PRIME=1, the other one.
# CMR3_SYSFS replaces /sys (tests).
gpu_env() {
  [ -n "${DRI_PRIME:-}${__NV_PRIME_RENDER_OFFLOAD:-}" ] && return
  sys=${CMR3_SYSFS:-/sys}
  n=0 nvidia= boot= boot_vram=0 other_vram=0
  for d in "$sys"/class/drm/card*; do
    case "${d##*/}" in *-*) continue ;; esac  # connectors (card0-DP-1)
    [ -r "$d/device/vendor" ] || continue
    n=$((n + 1))
    vram=$(cat "$d/device/mem_info_vram_total" 2>/dev/null || echo 0)
    [ "$(basename "$(readlink "$d/device/driver")")" = nvidia ] && nvidia=1
    if [ "$(cat "$d/device/boot_vga" 2>/dev/null)" = 1 ]; then
      boot=$(cat "$d/device/vendor"); boot_vram=$vram
    elif [ "$vram" -gt "$other_vram" ]; then
      other_vram=$vram
    fi
  done
  if [ -n "$nvidia" ] && $RUN sh -c 'ldconfig -p 2>/dev/null | grep -q libGLX_nvidia.so.0'; then
    echo "__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only"
  elif [ "$n" -ge 2 ] && { [ "$boot" = 0x8086 ] || [ "$other_vram" -gt "$boot_vram" ]; }; then
    echo "DRI_PRIME=1"
  fi
}

# Wine's DLL choices for the game: the launcher installs Xidi and the ASI
# loader into its own copy of the game (native, then Wine's builtin when
# they misbehave), and DXVK's d3d9.dll for the Vulkan path. winedbg is
# disabled so a crash in Wine's parts (a video-decoder regression, say)
# ends the game instead of freezing it in a hidden debugger. Overrides
# already set (the AppImage's, a player's) are kept after ours.
dll_overrides() {
  echo "dinput8,dsound,d3d9=n,b;winedbg=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
}

# One-time prefix settings: no crash dialog (winetricks' nocrashdialog),
# which would otherwise pop up over the game when a Wine part faults.
prepare_prefix() {
  grep -qs '"ShowCrashDialog"=dword:00000000' "$PREFIX/user.reg" && return 0
  $RUN env WINEPREFIX="$PREFIX" wine reg add 'HKCU\Software\Wine\WineDbg' \
    /v ShowCrashDialog /t REG_DWORD /d 0 /f >/dev/null 2>&1
  # Its wineserver must end first, or the game would join it outside
  # gamescope (see settings).
  $RUN env WINEPREFIX="$PREFIX" wineserver -w 2>/dev/null
}

# The game's window mode from launcher.cfg: gamescope only makes sense for
# the fullscreen one (windowed and borderless sizes themselves).
display_mode() { get_key display_mode; }

start() {
  if [ -z "$LAUNCHER" ] || [ ! -f "$LAUNCHER" ]; then
    echo "CMR3Launcher.exe not found next to cmr3-play (or set CMR3_LAUNCHER)"; exit 1
  fi
  res=$(get_key resolution); W=1920; H=1080
  case "$res" in
    original) W=640; H=480 ;;
    *x*) W=${res%x*}; H=${res#*x} ;;
  esac
  F=$(get_key scaler); F=${F:-linear}
  inner=$STATE/inner.sh
  cat > "$inner" <<INNER
#!/bin/sh
trap 'wineserver -k; exit' INT TERM HUP
wine '$LAUNCHER' --no-window
sleep 3; while pgrep -x Rally_3PC.exe >/dev/null; do sleep 1; done
wineserver -k
INNER
  chmod +x "$inner"
  export WINEDLLOVERRIDES="$(dll_overrides)"
  # Pads reach the game through Wine's SDL backend (Xidi reads them as
  # XInput). SDL finds every pad itself; naming a device as well
  # (SDL_JOYSTICK_DEVICE) would add the same pad a second time.
  export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS="${SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS:-1}"
  export SDL_JOYSTICK_HIDAPI="${SDL_JOYSTICK_HIDAPI:-0}"
  prepare_prefix
  # Already inside gamescope (a Steam Deck in Game Mode), a windowed mode,
  # or no gamescope installed: the game runs directly (a second gamescope
  # inside one fails).
  case "$(display_mode)" in windowed|borderless) windowed=1 ;; *) windowed= ;; esac
  if [ -n "$windowed" ] \
     || [ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ] \
     || ! $RUN sh -c "command -v gamescope" >/dev/null 2>&1; then
    echo "starting without a gamescope of our own"
    launch sh "$inner"
  else
    echo "starting at ${W}x${H}, scaler $F"
    launch gamescope -W "$W" -H "$H" -w "$W" -h "$H" -f -S fit -F "$F" -- "$inner"
  fi
}

# Runs a command in the prefix: in the background, or with CMR3_WAIT (the
# AppImage, unmounted when its script ends) until it exits.
launch() {
  if [ -n "${CMR3_WAIT:-}" ]; then
    $RUN env WINEPREFIX="$PREFIX" $GPU "$@" > "$STATE/play.log" 2>&1
  else
    setsid $RUN env WINEPREFIX="$PREFIX" $GPU "$@" > "$STATE/play.log" 2>&1 < /dev/null &
    echo $! > "$LOCK"
  fi
}

# Post-processing over the finished frame (postfx = color|cinematic in
# launcher.cfg): the vkBasalt layer over DXVK's Vulkan. The layer comes
# from the kit's thirdparty/vkbasalt, CMR3_VKBASALT, or a system install;
# without one, the game runs as it was.
postfx_env() {
  fx=$(get_key postfx)
  case "$fx" in color|cinematic) ;; *) return 0 ;; esac
  lib=""
  for p in "$(dirname "$LAUNCHER")/thirdparty/vkbasalt/libvkbasalt.so" \
           "$HERE/thirdparty/vkbasalt/libvkbasalt.so" \
           "${CMR3_VKBASALT:-}/libvkbasalt.so" \
           /usr/lib/vkbasalt/libvkbasalt.so \
           /usr/lib32/libvkbasalt.so /usr/lib/libvkbasalt.so; do
    [ -n "$p" ] && [ -f "$p" ] && lib=$p && break
  done
  if [ -z "$lib" ]; then
    echo "postfx: no vkBasalt layer found (bundle thirdparty/vkbasalt, set CMR3_VKBASALT, or install one); continuing without"
    return 0
  fi
  kbdir=$(dirname "$lib")
  mkdir -p "$STATE/vkbasalt"
  rm -f "$STATE/vkbasalt/layer.json" \
        "$STATE/vkbasalt/layer64.json" \
        "$STATE/vkbasalt/layer32.json"
  # One manifest per library bitness, each under its own layer name, both
  # requested: whichever matches the process (a WoW64 prefix loads the
  # 64-bit loader even for its 32-bit game) is the one that loads. The
  # paths are absolute because Wine drops LD_LIBRARY_PATH on its children.
  names=""
  for bits in 64 32; do
    case $bits in
      64) l="$kbdir/libvkbasalt.so" ;;
      32) l="$kbdir/lib32/libvkbasalt.so" ;;
    esac
    [ -f "$l" ] || continue
    name="VK_LAYER_VKBASALT_post_processing$([ "$bits" = 32 ] && echo 32)"
    cat > "$STATE/vkbasalt/layer$bits.json" <<JSON
{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "$name",
    "type": "GLOBAL",
    "library_path": "$l",
    "api_version": "1.3.223",
    "implementation_version": "1",
    "description": "vkBasalt post processing (CMR3Launcher)",
    "functions": {
      "vkGetInstanceProcAddr": "vkBasalt_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "vkBasalt_GetDeviceProcAddr"
    }
  }
}
JSON
    names="$names${names:+:}$name"
  done
  if [ -z "$names" ]; then
    echo "postfx: no vkBasalt library beside $lib; continuing without"
    return 0
  fi
  # The game's picture is washed out (blacks sit near 30/255, whites
  # under 170): both styles grade it through a colour lookup table first,
  # cinematic more strongly, then sharpen.
  case "$fx" in
    color) grade 0.08 0.90 1.15 1.08 ;;
    cinematic) grade 0.10 0.86 1.12 1.14 ;;
  esac > "$STATE/vkbasalt/grade.cube"
  effects=lut:cas
  extra=""
  if [ "$fx" = cinematic ] && [ -f "$STATE/vkbasalt/shaders/MxAO.fx" ]; then
    # The depth pass: only when the player supplied MxAO (licences keep
    # us from shipping it; docs/ENHANCEMENTS.md explains where from).
    effects=mxao:lut:cas
    extra="mxao = $STATE/vkbasalt/shaders/MxAO.fx
reshadeIncludePath = $STATE/vkbasalt/shaders
reshadeTexturePath = $STATE/vkbasalt/shaders"
  fi
  {
    echo "effects = $effects"
    [ -n "$extra" ] && echo "$extra"
    echo "lutFile = $STATE/vkbasalt/grade.cube"
    echo "casSharpness = 0.65"
    echo "executeAt = end"
  } > "$STATE/vkbasalt/vkBasalt.conf"
  export VK_LAYER_PATH="$STATE/vkbasalt"
  export VK_INSTANCE_LAYERS="$names"
  export VKBASALT_CONFIG_FILE="$STATE/vkbasalt/vkBasalt.conf"
  echo "postfx: $fx via $lib ($names)"
  return 0
}

# A 33-point colour lookup table (.cube, red fastest) that grades the
# picture: levels from black point $1 and white point $2 (0..1), gamma $3
# (above 1 lifts the midtones the levels darken), saturation $4.
grade() {
  awk -v b="$1" -v w="$2" -v g="$3" -v s="$4" '
  function clamp(v) { return v < 0 ? 0 : (v > 1 ? 1 : v) }
  BEGIN {
    n = 33
    print "LUT_3D_SIZE " n
    for (z = 0; z < n; z++) for (y = 0; y < n; y++) for (x = 0; x < n; x++) {
      c[0] = x / (n - 1); c[1] = y / (n - 1); c[2] = z / (n - 1)
      for (i = 0; i < 3; i++) {
        c[i] = clamp((c[i] - b) / (w - b)) ^ (1 / g)
      }
      l = 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
      for (i = 0; i < 3; i++) {
        c[i] = clamp(l + (c[i] - l) * s)
      }
      printf "%.6f %.6f %.6f\n", c[0], c[1], c[2]
    }
  }'
}

# The settings window; its exit code says what to do next.
settings() {
  $RUN env WINEPREFIX="$PREFIX" $GPU wine "$LAUNCHER" --settings --linux 2>/dev/null
  rc=$?
  # The window ran on the desktop. Its wineserver lingers for a few seconds
  # and is tied to the desktop's display; a game started meanwhile would
  # join it and open there instead of in gamescope. Wait for it to end.
  $RUN env WINEPREFIX="$PREFIX" wineserver -w 2>/dev/null
  case $rc in
    0|4) return 0 ;;  # Play pressed, or no window could be shown
    *) return 1 ;;    # closed
  esac
}

# Tests load the functions above without running anything.
[ -n "${CMR3_PLAY_FUNCTIONS_ONLY:-}" ] && return 0
GPU=$(gpu_env)
[ -n "$GPU" ] && echo "GPU: $GPU"
postfx_env

case "${1:-}" in
  "")
    if running; then echo "already running"; exit 0; fi
    if [ -z "$LAUNCHER" ] || [ ! -f "$LAUNCHER" ]; then
      echo "CMR3Launcher.exe not found next to cmr3-play (or set CMR3_LAUNCHER)"; exit 1
    fi
    settings || exit 0
    start ;;
  --play|start)
    if running; then echo "already running"; else start; fi ;;
  status) if running; then echo running; else echo idle; fi ;;
  stop)
    $RUN env WINEPREFIX="$PREFIX" wineserver -k 2>/dev/null
    [ -f "$LOCK" ] && kill "$(cat "$LOCK")" 2>/dev/null
    rm -f "$LOCK"
    echo stopped ;;
  *) echo "usage: $0 [--play|stop|status]"; exit 2 ;;
esac
